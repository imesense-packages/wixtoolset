<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Id="ImeSense.WixToolset.CommandLineTools$(SetupMajorVersion).Package" Name="ImeSense WiX Toolset Command-Line Tools" Manufacturer="$(Company)" Version="!(bind.fileVersion.WixExe)">
    <MediaTemplate EmbedCab="yes" />

    <ComponentGroupRef Id="BinaryFiles" />
    <ComponentGroupRef Id="ExtensionFiles" />

    <Property Id="ARPURLINFOABOUT" Value="https://wixtoolset.org/" />
    <Property Id="ARPHELPLINK" Value="https://wixtoolset.org/docs/gethelp/" />
    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]" After="CostFinalize" />

    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="..\LICENSE.rtf" />
  </Package>

  <Fragment>
    <ComponentGroup Id="BinaryFiles" Directory="BinFolder">
      <Component>
        <File Id="WixExe" Source="!(bindpath.Files)\wix.exe" />
        <File Source="!(bindpath.Files)\wix.exe.config" />

        <Environment Name="PATH" Value="[BinFolder]" Action="set" Part ="last" System="yes" />
        <Environment Name="WIX$(SetupMajorVersion)" Value="[BinFolder]" Action="set" System="yes" />
      </Component>

      <Files Include="!(bindpath.Files)\**">
        <Exclude Files="!(bindpath.Files)\wix.exe*" />
        <Exclude Files="!(bindpath.Files)\**\*.xml" />
        <Exclude Files="!(bindpath.Files)\**\*.targets" />
      </Files>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="ExtensionFiles" Directory="ExtensionFolder">
      <File Subdirectory="ImeSense.WixToolset.BootstrapperApplications.wixext\$(SetupMajorMinorPatchVersion)\wixext$(SetupMajorVersion)"
            Source="ImeSense.WixToolset.BootstrapperApplications.wixext.dll" />
      <File Subdirectory="ImeSense.WixToolset.ComPlus.wixext\$(SetupMajorMinorPatchVersion)\wixext$(SetupMajorVersion)"
            Source="ImeSense.WixToolset.ComPlus.wixext.dll" />
      <File Subdirectory="ImeSense.WixToolset.Dependency.wixext\$(SetupMajorMinorPatchVersion)\wixext$(SetupMajorVersion)"
            Source="ImeSense.WixToolset.Dependency.wixext.dll" />
      <File Subdirectory="ImeSense.WixToolset.DirectX.wixext\$(SetupMajorMinorPatchVersion)\wixext$(SetupMajorVersion)"
            Source="ImeSense.WixToolset.DirectX.wixext.dll" />
      <File Subdirectory="ImeSense.WixToolset.Firewall.wixext\$(SetupMajorMinorPatchVersion)\wixext$(SetupMajorVersion)"
            Source="ImeSense.WixToolset.Firewall.wixext.dll" />
      <File Subdirectory="ImeSense.WixToolset.Http.wixext\$(SetupMajorMinorPatchVersion)\wixext$(SetupMajorVersion)"
            Source="ImeSense.WixToolset.Http.wixext.dll" />
      <File Subdirectory="ImeSense.WixToolset.Iis.wixext\$(SetupMajorMinorPatchVersion)\wixext$(SetupMajorVersion)"
            Source="ImeSense.WixToolset.Iis.wixext.dll" />
      <File Subdirectory="ImeSense.WixToolset.Msmq.wixext\$(SetupMajorMinorPatchVersion)\wixext$(SetupMajorVersion)"
            Source="ImeSense.WixToolset.Msmq.wixext.dll" />
      <File Subdirectory="ImeSense.WixToolset.NetFx.wixext\$(SetupMajorMinorPatchVersion)\wixext$(SetupMajorVersion)"
            Source="ImeSense.WixToolset.NetFx.wixext.dll" />
      <File Subdirectory="ImeSense.WixToolset.PowerShell.wixext\$(SetupMajorMinorPatchVersion)\wixext$(SetupMajorVersion)"
            Source="ImeSense.WixToolset.PowerShell.wixext.dll" />
      <File Subdirectory="ImeSense.WixToolset.Sql.wixext\$(SetupMajorMinorPatchVersion)\wixext$(SetupMajorVersion)"
            Source="ImeSense.WixToolset.Sql.wixext.dll" />
      <File Subdirectory="ImeSense.WixToolset.UI.wixext\$(SetupMajorMinorPatchVersion)\wixext$(SetupMajorVersion)"
            Source="ImeSense.WixToolset.UI.wixext.dll" />
      <File Subdirectory="ImeSense.WixToolset.Util.wixext\$(SetupMajorMinorPatchVersion)\wixext$(SetupMajorVersion)"
            Source="ImeSense.WixToolset.Util.wixext.dll" />
      <File Subdirectory="ImeSense.WixToolset.VisualStudio.wixext\$(SetupMajorMinorPatchVersion)\wixext$(SetupMajorVersion)"
            Source="ImeSense.WixToolset.VisualStudio.wixext.dll" />
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="ImeSenseFolder" Name="ImeSense">
        <Directory Id="WixToolsetFolder" Name="WiX Toolset">
          <Directory Id="INSTALLFOLDER" Name="$(SetupMajorMinorVersion)">
            <Directory Id="BinFolder" Name="bin" />
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>
  </Fragment>

  <Fragment>
    <StandardDirectory Id="CommonFiles64Folder">
      <Directory Id="ImeSenseCommonFolder" Name="ImeSense">
        <Directory Id="ExtensionFolder" Name="WixToolset\extensions" />
      </Directory>
    </StandardDirectory>
  </Fragment>
</Wix>
