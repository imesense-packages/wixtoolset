<?xml version="1.0"?>
<package >
  <metadata minClientVersion="4.0">
    <license type="file">LICENSE.TXT</license>
    <id>$id$</id>
    <version>$version$</version>
    <title>$title$</title>
    <description>$description$</description>
    <authors>$authors$</authors>
    <owners>ImeSense</owners>
    <readme>README.md</readme>
    <tags>$packageTags$</tags>
    <copyright>$copyright$</copyright>
    <projectUrl>$projectUrl$</projectUrl>
    <repository type="$repositorytype$" url="$repositoryurl$" commit="$repositorycommit$" />
    <dependencies>
        <dependency id="ImeSense.WixToolset.DUtil" version="[$version$,$nextmajorversion$)" />
    </dependencies>
  </metadata>

  <files>
    <file src="$projectFolder$\..\README.md" />
    <file src="$projectFolder$\build\$id$.props" target="build\" />
    <file src="$projectFolder$\inc\*" target="build\native\include" />
    <file src="..\..\v143\x64\wcautil.lib" target="build\native\v14\x64" />
    <file src="..\..\v143\x86\wcautil.lib" target="build\native\v14\x86" />
    <file src="..\..\v143\ARM64\wcautil.lib" target="build\native\v14\ARM64" />
    <file src="$eulaTxt$" target="LICENSE.TXT" />
  </files>
</package>
